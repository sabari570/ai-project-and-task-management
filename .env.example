# Copy this file to .env for local development.
# These defaults are intended for local use only.

APP_NAME=ProjectHub AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Optional locally; required in production.
# Generate a long random value for production and store it securely.
SECRET_KEY=

POSTGRES_DB=projecthub
POSTGRES_USER=projecthub_user
POSTGRES_PASSWORD=change-this-local-password

DATABASE_URL=postgresql+psycopg://projecthub_user:change-this-local-password@localhost:5432/projecthub